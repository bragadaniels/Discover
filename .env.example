# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for automatic video discovery.
# Leave blank if not configured; News, Crossref, and arXiv continue working normally.
YOUTUBE_API_KEY=""

# SEMANTIC_SCHOLAR_API_KEY: Optional Semantic Scholar Graph API key for higher rate limits.
# Leave blank to use the free unauthenticated tier.
SEMANTIC_SCHOLAR_API_KEY=""

# OPENALEX_MAILTO: Optional contact email for OpenAlex polite pool routing.
OPENALEX_MAILTO=""

